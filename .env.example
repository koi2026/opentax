# law.go.kr DRF API
LAW_API_OC=your_oc_code
LAW_API_BASE_URL=https://www.law.go.kr/DRF

# LLM
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-7

# Embeddings (Upstage Solar 우선, fallback OpenAI)
UPSTAGE_API_KEY=
# 문서 임베딩: solar-embedding-1-large-passage
# 쿼리 임베딩: solar-embedding-1-large-query
UPSTAGE_EMBEDDING_MODEL=solar-embedding-1-large-passage
OPENAI_API_KEY=sk-proj-...

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=tax-rag
PINECONE_NAMESPACE=tax-law
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_HYBRID_ALPHA=  # Optional: 0.75 for hybrid search (dense+sparse BM25). Leave empty to use dense-only.

# Gemini (CCG / omc ask gemini 용)
GEMINI_API_KEY=

# Reranker
BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Ports
FASTAPI_PORT=8000
MCP_PORT=8001
STREAMLIT_PORT=8501

# 규제지역 변경 감지 알림
SLACK_WEBHOOK_URL=           # Slack incoming webhook URL
ALERT_EMAIL_TO=              # 수신 이메일
ALERT_EMAIL_FROM=            # 발신 Gmail 계정
ALERT_EMAIL_PASSWORD=        # Gmail 앱 비밀번호 (2단계 인증 필요)
AREA_AUTO_APPLY=0            # 1이면 고신뢰(P0+confidence≥0.8) 조건에서 auto-apply

# 뉴스 API (네이버 뉴스 검색, P2 weak signal)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
